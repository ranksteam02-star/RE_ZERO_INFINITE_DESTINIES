    "meeting": {
      "type": "dialogue",
      "speaker": "เอมิเลีย",
      "text": "เธอดูหลงทางนะ ถ้ากำลังหาทางไปลานกลางเมือง ฉันเดินไปด้วยได้",
      "next_node": "reply",
