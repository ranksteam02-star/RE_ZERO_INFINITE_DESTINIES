    },
    "reply": {
      "type": "dialogue",
      "speaker": "สุบารุ",
      "text": "ขอบคุณนะ ฉันมีเรื่องอยากถามเยอะเลย แต่เริ่มจากชื่อของเธอก่อนก็แล้วกัน",
      "next_node": "end",
      "portrait": "",
      "background": "res://assets/backgrounds/dusk.svg"
    },
    "end": {
      "type": "dialogue",
      "speaker": "เอมิเลีย",
      "text": "ฉันชื่อเอมิเลีย ไปกันเถอะ ก่อนที่แสงไฟบนถนนจะดับลง",
      "next_node": "decision",
