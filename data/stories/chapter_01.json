    "arrival": {
      "type": "dialogue",
      "speaker": "สุบารุ",
      "text": "ที่นี่คือที่ไหนกัน… เมื่อกี้ฉันยังเดินอยู่บนถนนอีกสายหนึ่งแท้ ๆ",
      "next_node": "meeting",
      "portrait": "",
